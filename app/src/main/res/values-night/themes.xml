<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TwedMark" parent="android:Theme.Material.NoActionBar">
        <!-- Splash: fondo negro puro en tema oscuro (válido también para AMOLED) -->
        <item name="android:windowBackground">@android:color/black</item>

        <!-- Barras 100% transparentes -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Sin scrim de contraste forzado desde el primer frame (API 29+) -->
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- Desactivar force-dark a nivel de tema (API 29+) -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Extender contenido al área del notch (API 28+) -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">
            shortEdges
        </item>
    </style>
</resources>